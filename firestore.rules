rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isRoomMember(roomData) {
      return isSignedIn() && (request.auth.uid in roomData.players);
    }

    function isRoomHost(roomData) {
      return isSignedIn() && roomData.hostUid == request.auth.uid;
    }

    function isValidTransition(fromStatus, toStatus) {
      return (fromStatus == toStatus)
        || (fromStatus == 'waiting' && toStatus in ['in_progress', 'closed', 'expired'])
        || (fromStatus == 'in_progress' && toStatus in ['completed', 'closed', 'expired'])
        || (fromStatus == 'completed' && toStatus in ['in_progress', 'closed', 'expired'])
        || (fromStatus == 'closed' && toStatus == 'expired');
    }

    function immutableFieldsUnchanged() {
      return request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.gameType == resource.data.gameType
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Validates a host-controlled Memory Match settings object:
    // - cardCount: even integer between 10 and 100
    // - minPlayers / maxPlayers: integers between 2 and 8 with minPlayers <= maxPlayers
    function isValidMemoryRoomSettings(settings) {
      return settings is map
        && settings.cardCount is int
        && settings.cardCount >= 10
        && settings.cardCount <= 100
        && settings.cardCount % 2 == 0
        && settings.minPlayers is int
        && settings.minPlayers >= 2
        && settings.minPlayers <= 8
        && settings.maxPlayers is int
        && settings.maxPlayers >= 2
        && settings.maxPlayers <= 8
        && settings.minPlayers <= settings.maxPlayers;
    }

    // Ensures neither maxPlayers nor memoryRoomSettings changed on updates that do not edit settings.
    function roomSettingsUnchanged() {
      return request.resource.data.maxPlayers == resource.data.maxPlayers
        && (
          (!('memoryRoomSettings' in resource.data) && !('memoryRoomSettings' in request.resource.data))
          || (
            ('memoryRoomSettings' in resource.data)
            && ('memoryRoomSettings' in request.resource.data)
            && request.resource.data.memoryRoomSettings == resource.data.memoryRoomSettings
          )
        );
    }

    // Host-only update to persistent Memory Match settings, allowed ONLY in 'waiting' or 'completed'
    // (strictly forbidden while 'in_progress'). Never mutates active or completed match state.
    function isValidHostMemorySettingsUpdate() {
      return resource.data.gameType == 'memory-match'
        && isRoomHost(resource.data)
        && resource.data.status in ['waiting', 'completed']
        && request.resource.data.status == resource.data.status
        && request.resource.data.players == resource.data.players
        && request.resource.data.playerOrder == resource.data.playerOrder
        && request.resource.data.currentTurnUid == resource.data.currentTurnUid
        && request.resource.data.ticTacToeState == resource.data.ticTacToeState
        && request.resource.data.memoryMatchState == resource.data.memoryMatchState
        && ('memoryRoomSettings' in request.resource.data)
        && isValidMemoryRoomSettings(request.resource.data.memoryRoomSettings)
        && request.resource.data.maxPlayers == request.resource.data.memoryRoomSettings.maxPlayers
        && request.resource.data.maxPlayers >= resource.data.playerOrder.size();
    }

    // Ensures only the authenticated caller's own player entry is modified,
    // and their identity (uid), host role (isHost), join time, and symbol remain unchanged.
    function onlyCallerPlayerModified() {
      return (request.auth.uid in resource.data.players)
        && (request.auth.uid in request.resource.data.players)
        && request.resource.data.players.diff(resource.data.players).addedKeys().size() == 0
        && request.resource.data.players.diff(resource.data.players).removedKeys().size() == 0
        && request.resource.data.players.diff(resource.data.players).changedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players[request.auth.uid].uid == resource.data.players[request.auth.uid].uid
        && request.resource.data.players[request.auth.uid].isHost == resource.data.players[request.auth.uid].isHost
        && request.resource.data.players[request.auth.uid].joinedAt == resource.data.players[request.auth.uid].joinedAt
        && request.resource.data.players[request.auth.uid].symbol == resource.data.players[request.auth.uid].symbol;
    }

    // Ensures only the caller's player entry changed (e.g. heartbeat/rematch vote) and their score did not change.
    function callerScoreUnchanged() {
      return onlyCallerPlayerModified()
        && request.resource.data.players[request.auth.uid].score == resource.data.players[request.auth.uid].score;
    }

    // Validates a new guest joining a waiting room without modifying existing players or claiming host role.
    function isValidWaitingRoomJoin() {
      return !(request.auth.uid in resource.data.players)
        && (request.auth.uid in request.resource.data.players)
        && request.resource.data.players.diff(resource.data.players).addedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players.diff(resource.data.players).removedKeys().size() == 0
        && request.resource.data.players.diff(resource.data.players).changedKeys().size() == 0
        && request.resource.data.players[request.auth.uid].uid == request.auth.uid
        && request.resource.data.players[request.auth.uid].isHost == false
        && request.resource.data.players[request.auth.uid].score == 0
        && request.resource.data.players[request.auth.uid].rematchAccepted == false
        && request.resource.data.playerOrder.size() == resource.data.playerOrder.size() + 1
        && request.resource.data.playerOrder.size() <= resource.data.maxPlayers
        && (request.auth.uid in request.resource.data.playerOrder);
    }

    // Validates a guest leaving a waiting room (removing only their own player entry).
    function isValidWaitingRoomLeave() {
      return (request.auth.uid in resource.data.players)
        && !isRoomHost(resource.data)
        && !(request.auth.uid in request.resource.data.players)
        && request.resource.data.players.diff(resource.data.players).addedKeys().size() == 0
        && request.resource.data.players.diff(resource.data.players).removedKeys().hasOnly([request.auth.uid])
        && request.resource.data.players.diff(resource.data.players).changedKeys().size() == 0
        && request.resource.data.playerOrder.size() == resource.data.playerOrder.size() - 1
        && !(request.auth.uid in request.resource.data.playerOrder);
    }

    // Enforces that Memory Match matchedPairs increases by at most 1 per move,
    // existing matched-pair ownership in matchedByPairKey can never be removed or overwritten,
    // and any newly matched pair is owned by request.auth.uid.
    //
    // Architectural Limitation (Client-Side Match Resolution):
    // Firestore Security Rules v2 do not support unbounded loops or arbitrary index lookup over the
    // 20-to-100-element `cards` list to independently verify that two flipped card IDs share the same
    // hidden `pairKey`. Rules strictly enforce turn ownership (`currentTurnUid == request.auth.uid`),
    // cap `pairDelta` to at most +1 per turn, tie any caller score increase to `pairDelta`, and
    // prevent overwriting or removing prior `matchedByPairKey` entries, but a modified client on its
    // own turn could potentially submit a synthetic match (`pairDelta == 1`) without genuinely matching
    // two cards. Full server-authoritative match resolution would require moving card-flip evaluation
    // into a trusted backend (e.g. Cloud Functions for Firebase with a private deck subcollection).
    function isValidMemoryMatchPairOwnershipDiff() {
      let prevMM = resource.data.memoryMatchState;
      let nextMM = request.resource.data.memoryMatchState;
      let pairDelta = nextMM.matchedPairs - prevMM.matchedPairs;
      let ownerDiff = nextMM.matchedByPairKey.diff(prevMM.matchedByPairKey);
      return pairDelta >= 0
        && pairDelta <= 1
        && ownerDiff.removedKeys().size() == 0
        && ownerDiff.changedKeys().size() == 0
        && ownerDiff.addedKeys().size() == pairDelta
        && (
          pairDelta == 0
          || (
            nextMM.lastMatchedPairKey != null
            && ownerDiff.addedKeys().hasOnly([nextMM.lastMatchedPairKey])
            && nextMM.matchedByPairKey[nextMM.lastMatchedPairKey] == request.auth.uid
          )
        );
    }

    // Validates an active-turn player move in Memory Match.
    function isValidMemoryMatchTurnMove() {
      let prevMM = resource.data.memoryMatchState;
      let nextMM = request.resource.data.memoryMatchState;
      let pairDelta = nextMM.matchedPairs - prevMM.matchedPairs;
      return resource.data.gameType == 'memory-match'
        && prevMM != null
        && nextMM != null
        && request.resource.data.ticTacToeState == resource.data.ticTacToeState
        && nextMM.totalPairs == prevMM.totalPairs
        && nextMM.turnOrderUids == prevMM.turnOrderUids
        && nextMM.cards.size() == prevMM.cards.size()
        && isValidMemoryMatchPairOwnershipDiff()
        && onlyCallerPlayerModified()
        && request.resource.data.players[request.auth.uid].score == resource.data.players[request.auth.uid].score + pairDelta;
    }

    // Validates an active-turn player move in Tic-Tac-Toe.
    function isValidTicTacToeTurnMove() {
      let prevTTT = resource.data.ticTacToeState;
      let nextTTT = request.resource.data.ticTacToeState;
      let scoreDelta = request.resource.data.players[request.auth.uid].score - resource.data.players[request.auth.uid].score;
      return resource.data.gameType == 'tic-tac-toe'
        && prevTTT != null
        && nextTTT != null
        && request.resource.data.memoryMatchState == resource.data.memoryMatchState
        && nextTTT.playerXUid == prevTTT.playerXUid
        && nextTTT.playerOUid == prevTTT.playerOUid
        && nextTTT.roundNumber == prevTTT.roundNumber
        && nextTTT.board.size() == 9
        && onlyCallerPlayerModified()
        && scoreDelta >= 0
        && scoreDelta <= 1
        && (scoreDelta == 0 || request.resource.data.status == 'completed');
    }

    // Restricts mismatch-reset operations strictly to turning mismatched cards face down and advancing turn.
    // Prevents any changes to player scores, matchedPairs, or matched-card ownership.
    function isValidMismatchReset() {
      let prevMM = resource.data.memoryMatchState;
      let nextMM = request.resource.data.memoryMatchState;
      return resource.data.gameType == 'memory-match'
        && request.resource.data.status == 'in_progress'
        && prevMM != null
        && nextMM != null
        && prevMM.pendingResetAt != null
        && prevMM.flippedCardIds.size() == 2
        && request.resource.data.players == resource.data.players
        && request.resource.data.ticTacToeState == resource.data.ticTacToeState
        && nextMM.diff(prevMM).affectedKeys().hasOnly([
          'cards',
          'lastMatchedPairKey',
          'currentTurnIndex',
          'currentTurnUid',
          'flippedCardIds',
          'pendingResetAt',
          'turnSequence',
          'turnStartedAt'
        ])
        && nextMM.totalPairs == prevMM.totalPairs
        && nextMM.matchedPairs == prevMM.matchedPairs
        && nextMM.matchedByPairKey == prevMM.matchedByPairKey
        && nextMM.turnOrderUids == prevMM.turnOrderUids
        && nextMM.winnerUids == prevMM.winnerUids
        && nextMM.isTie == prevMM.isTie
        && nextMM.flippedCardIds.size() == 0
        && nextMM.pendingResetAt == null
        && request.resource.data.currentTurnUid == nextMM.currentTurnUid
        && (request.resource.data.currentTurnUid in resource.data.playerOrder);
    }

    // Validates a room member skipping an inactive/disconnected player's turn in Memory Match.
    // Strictly forbids self-skips, score/match manipulation, and duplicate skips on the same turnSequence.
    function isValidMemoryMatchTurnSkip() {
      let prevMM = resource.data.memoryMatchState;
      let nextMM = request.resource.data.memoryMatchState;
      let prevSeq = ('turnSequence' in prevMM && prevMM.turnSequence is int) ? prevMM.turnSequence : 1;
      return resource.data.gameType == 'memory-match'
        && request.resource.data.status == 'in_progress'
        && prevMM != null
        && nextMM != null
        && resource.data.currentTurnUid != request.auth.uid
        && request.resource.data.players == resource.data.players
        && request.resource.data.ticTacToeState == resource.data.ticTacToeState
        && nextMM.totalPairs == prevMM.totalPairs
        && nextMM.matchedPairs == prevMM.matchedPairs
        && nextMM.matchedByPairKey == prevMM.matchedByPairKey
        && nextMM.turnOrderUids == prevMM.turnOrderUids
        && nextMM.cards.size() == prevMM.cards.size()
        && nextMM.winnerUids == prevMM.winnerUids
        && nextMM.isTie == prevMM.isTie
        && nextMM.flippedCardIds.size() == 0
        && nextMM.pendingResetAt == null
        && request.resource.data.currentTurnUid == nextMM.currentTurnUid
        && (request.resource.data.currentTurnUid in resource.data.playerOrder)
        && request.resource.data.currentTurnUid != resource.data.currentTurnUid
        && nextMM.turnSequence == prevSeq + 1
        && nextMM.lastSkippedTurn != null
        && nextMM.lastSkippedTurn.skippedUid == resource.data.currentTurnUid
        && nextMM.lastSkippedTurn.skippedByUid == request.auth.uid;
    }

    function rematchPlayerReset(uid) {
      return request.resource.data.players[uid].score == 0
        && request.resource.data.players[uid].rematchAccepted == false;
    }

    // Minimum joined players required to start or rematch:
    // - Tic-Tac-Toe -> 2 players
    // - Memory Match -> host-configured memoryRoomSettings.minPlayers (fallback 2 for legacy rooms)
    function minPlayersForRoom(roomData) {
      return roomData.gameType == 'tic-tac-toe'
        ? 2
        : (('memoryRoomSettings' in roomData && roomData.memoryRoomSettings != null)
          ? roomData.memoryRoomSettings.minPlayers
          : 2);
    }

    // Expected card count for Memory Match from persistent room settings (fallback 20 for legacy rooms):
    function expectedCardCountForRoom(roomData) {
      return ('memoryRoomSettings' in roomData && roomData.memoryRoomSettings != null)
        ? roomData.memoryRoomSettings.cardCount
        : 20;
    }

    // Host starting the next Memory Match round immediately using the latest saved room settings:
    // fresh deck matching expectedCardCountForRoom, scores zeroed, ownership cleared, round incremented.
    function isValidMemoryMatchRematchStart() {
      let order = resource.data.playerOrder;
      let prevMM = resource.data.memoryMatchState;
      let nextMM = request.resource.data.memoryMatchState;
      let expectedCards = expectedCardCountForRoom(resource.data);
      let expectedPairs = expectedCards / 2;
      return resource.data.gameType == 'memory-match'
        && prevMM != null
        && nextMM != null
        && isRoomHost(resource.data)
        && roomSettingsUnchanged()
        && order.size() >= minPlayersForRoom(resource.data)
        && order.size() <= resource.data.maxPlayers
        && request.resource.data.status == 'in_progress'
        && request.resource.data.currentTurnUid == order[0]
        && nextMM.currentTurnUid == order[0]
        && nextMM.currentTurnIndex == 0
        && nextMM.turnOrderUids == order
        && nextMM.roundNumber == prevMM.roundNumber + 1
        && nextMM.matchedPairs == 0
        && nextMM.matchedByPairKey.size() == 0
        && nextMM.totalPairs == expectedPairs
        && nextMM.cards.size() == expectedCards
        && nextMM.flippedCardIds.size() == 0
        && nextMM.pendingResetAt == null
        && nextMM.winnerUids.size() == 0
        && nextMM.isTie == false
        && request.resource.data.ticTacToeState == resource.data.ticTacToeState
        && rematchPlayerReset(order[0])
        && rematchPlayerReset(order[1])
        && (order.size() < 3 || rematchPlayerReset(order[2]))
        && (order.size() < 4 || rematchPlayerReset(order[3]))
        && (order.size() < 5 || rematchPlayerReset(order[4]))
        && (order.size() < 6 || rematchPlayerReset(order[5]))
        && (order.size() < 7 || rematchPlayerReset(order[6]))
        && (order.size() < 8 || rematchPlayerReset(order[7]));
    }

    match /rooms/{roomCode} {
      // Authenticated players may read room state to join by code or listen to active room updates
      allow read: if isSignedIn();

      // Room creation: creator must be authenticated, set themselves as host, and start in 'waiting'
      allow create: if isSignedIn()
        && request.resource.data.roomCode == roomCode
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.gameType in ['tic-tac-toe', 'memory-match']
        && request.resource.data.maxPlayers in [2, 3, 4, 5, 6, 7, 8]
        && (
          (request.resource.data.gameType == 'tic-tac-toe' && request.resource.data.maxPlayers == 2)
          || (
            request.resource.data.gameType == 'memory-match'
            && ('memoryRoomSettings' in request.resource.data)
            && isValidMemoryRoomSettings(request.resource.data.memoryRoomSettings)
            && request.resource.data.maxPlayers == request.resource.data.memoryRoomSettings.maxPlayers
          )
        )
        && (request.auth.uid in request.resource.data.players)
        && request.resource.data.players[request.auth.uid].uid == request.auth.uid
        && request.resource.data.players[request.auth.uid].isHost == true
        && request.resource.data.players[request.auth.uid].score == 0
        && request.resource.data.playerOrder.size() == 1
        && request.resource.data.playerOrder[0] == request.auth.uid;

      // Room updates: enforce state machine, host permissions, capacity limits, turn locks, and ownership immutability
      allow update: if isSignedIn()
        && immutableFieldsUnchanged()
        && isValidTransition(resource.data.status, request.resource.data.status)
        && !(resource.data.status in ['closed', 'expired'])
        && (
          // 1. Marking a room expired is only permitted once its expiresAt timestamp has elapsed
          (
            roomSettingsUnchanged()
            && request.resource.data.status == 'expired'
            && request.time.toMillis() >= resource.data.expiresAt
          )
          ||
          // 2. Host closing the room
          (
            roomSettingsUnchanged()
            && request.resource.data.status == 'closed'
            && isRoomHost(resource.data)
            && request.resource.data.playerOrder == resource.data.playerOrder
          )
          ||
          // 3. Joining, leaving, updating own heartbeat, or host editing room settings while 'waiting'
          (
            resource.data.status == 'waiting'
            && request.resource.data.status == 'waiting'
            && request.resource.data.ticTacToeState == null
            && request.resource.data.memoryMatchState == null
            && (
              (roomSettingsUnchanged() && isValidWaitingRoomJoin())
              || (
                roomSettingsUnchanged()
                && callerScoreUnchanged()
                && request.resource.data.playerOrder == resource.data.playerOrder
              )
              || (roomSettingsUnchanged() && isValidWaitingRoomLeave())
              || isValidHostMemorySettingsUpdate()
            )
          )
          ||
          // 4. Host starting the game once configured minimum player count is reached
          (
            roomSettingsUnchanged()
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'in_progress'
            && isRoomHost(resource.data)
            && resource.data.playerOrder.size() >= minPlayersForRoom(resource.data)
            && resource.data.playerOrder.size() <= resource.data.maxPlayers
            && request.resource.data.playerOrder == resource.data.playerOrder
            && request.resource.data.players.diff(resource.data.players).addedKeys().size() == 0
            && request.resource.data.players.diff(resource.data.players).removedKeys().size() == 0
            && request.resource.data.currentTurnUid == resource.data.playerOrder[0]
            && (
              resource.data.gameType != 'memory-match'
              || (
                request.resource.data.memoryMatchState != null
                && request.resource.data.memoryMatchState.matchedPairs == 0
                && request.resource.data.memoryMatchState.matchedByPairKey.size() == 0
                && request.resource.data.memoryMatchState.turnOrderUids == resource.data.playerOrder
                && request.resource.data.memoryMatchState.cards.size() == expectedCardCountForRoom(resource.data)
                && request.resource.data.memoryMatchState.totalPairs == expectedCardCountForRoom(resource.data) / 2
              )
            )
          )
          ||
          // 5. Active gameplay updates (settings strictly locked; turn-validated moves, heartbeats, or mismatch resets)
          (
            roomSettingsUnchanged()
            && resource.data.status == 'in_progress'
            && request.resource.data.status in ['in_progress', 'completed']
            && isRoomMember(resource.data)
            && request.resource.data.playerOrder == resource.data.playerOrder
            && (
              // 5a. Active turn player making a validated move
              (
                resource.data.currentTurnUid == request.auth.uid
                && (isValidMemoryMatchTurnMove() || isValidTicTacToeTurnMove())
              )
              ||
              // 5b. Member updating only their own connection status / heartbeat
              (
                request.resource.data.status == 'in_progress'
                && request.resource.data.currentTurnUid == resource.data.currentTurnUid
                && request.resource.data.ticTacToeState == resource.data.ticTacToeState
                && request.resource.data.memoryMatchState == resource.data.memoryMatchState
                && callerScoreUnchanged()
              )
              ||
              // 5c. Resolving a revealed mismatch pair without altering scores or matched pairs
              isValidMismatchReset()
              ||
              // 5d. Room member skipping an inactive/disconnected player's turn without altering scores/matches
              isValidMemoryMatchTurnSkip()
            )
          )
          ||
          // 6. Post-game member heartbeat, host updating next-round settings, or host initiating rematch
          (
            resource.data.status == 'completed'
            && isRoomMember(resource.data)
            && request.resource.data.playerOrder == resource.data.playerOrder
            && (
              (
                roomSettingsUnchanged()
                && request.resource.data.status == 'completed'
                && request.resource.data.ticTacToeState == resource.data.ticTacToeState
                && request.resource.data.memoryMatchState == resource.data.memoryMatchState
                && callerScoreUnchanged()
              )
              || isValidHostMemorySettingsUpdate()
              ||
              (
                roomSettingsUnchanged()
                && request.resource.data.status == 'in_progress'
                && isRoomHost(resource.data)
                && request.resource.data.players.diff(resource.data.players).addedKeys().size() == 0
                && request.resource.data.players.diff(resource.data.players).removedKeys().size() == 0
                && (
                  resource.data.gameType != 'memory-match'
                  || isValidMemoryMatchRematchStart()
                )
              )
            )
          )
        );

      // Room cleanup/deletion allowed by host or once room is closed/expired
      allow delete: if isSignedIn()
        && (
          isRoomHost(resource.data)
          || resource.data.status in ['closed', 'expired']
          || request.time.toMillis() >= resource.data.expiresAt
          || resource.data.playerOrder.size() == 0
        );

      // Helper: verifies the parent room exists, is still active, and the caller is a member.
      function isActiveParentRoomMember() {
        let parentRoom = get(/databases/$(database)/documents/rooms/$(roomCode));
        return isSignedIn()
          && parentRoom != null
          && parentRoom.data != null
          && parentRoom.data.status in ['waiting', 'in_progress', 'completed']
          && (request.auth.uid in parentRoom.data.players);
      }

      function isActiveParentRoomHost() {
        let parentRoom = get(/databases/$(database)/documents/rooms/$(roomCode));
        return isActiveParentRoomMember()
          && parentRoom.data.hostUid == request.auth.uid;
      }

      // Real-time player reactions subcollection (isolated from game state, 9 arcade reactions)
      match /reactions/{reactionId} {
        allow read: if isActiveParentRoomMember();
        allow create: if isActiveParentRoomMember()
          && request.resource.data.roomCode == roomCode
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 32
          && request.resource.data.emoji in ['😂', '👏', '🔥', '😮', '😭', '🎉', '❤️', '😎', '😡']
          && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }

      // Real-time room chat subcollection (persists across rounds while room is active)
      match /messages/{messageId} {
        allow read: if isActiveParentRoomMember();
        allow create: if isActiveParentRoomMember()
          && request.resource.data.roomCode == roomCode
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 1
          && request.resource.data.nickname.size() <= 32
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 200
          && request.resource.data.createdAt is number;
        allow update: if false;
        allow delete: if isActiveParentRoomMember()
          && (
            isActiveParentRoomHost()
            || resource.data.uid == request.auth.uid
          );
      }
    }

    // Persistent player profiles: owner-only create/update, protected immutable fields & stats
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.usernameLower is string
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.matches('^[A-Z]{2}$')
        && request.resource.data.countryName is string
        && request.resource.data.countryName.size() >= 2
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.stats == resource.data.stats
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.matches('^[A-Z]{2}$')
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // Atomic username reservations guaranteeing globally unique usernames
    match /usernames/{usernameLower} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 20
        && !exists(/databases/$(database)/documents/usernames/$(usernameLower));
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Registered (non-anonymous) authenticated user helper for persistent user-owned arcade rooms
    function isRegisteredUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Level 1: Persistent user-owned Arcade Rooms (separate from individual Level 2 game sessions)
    match /arcadeRooms/{arcadeRoomId} {
      function isArcadeOwner(data) {
        return isRegisteredUser() && data.ownerUid == request.auth.uid;
      }

      function isArcadeManager(data) {
        return isRegisteredUser()
          && (data.ownerUid == request.auth.uid || (request.auth.uid in data.managerUids));
      }

      function isArcadeMember(data) {
        return isSignedIn() && (request.auth.uid in data.memberUids);
      }

      function arcadeImmutableUnchanged() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      // Members can read any room they belong to; invite-only active rooms can be looked up by invite code
      allow read: if isSignedIn()
        && (
          isArcadeMember(resource.data)
          || (resource.data.visibility == 'invite-only' && resource.data.status == 'active')
        );

      // Strictly registered (non-anonymous) users can create persistent arcade rooms
      allow create: if isRegisteredUser()
        && request.resource.data.id == arcadeRoomId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.availableGames is list
        && request.resource.data.availableGames.size() >= 1
        && request.resource.data.visibility in ['invite-only', 'private']
        && request.resource.data.status == 'active'
        && request.resource.data.defaultMemoryCardCount is int
        && request.resource.data.defaultMemoryCardCount >= 10
        && request.resource.data.defaultMemoryCardCount <= 100
        && request.resource.data.defaultMemoryCardCount % 2 == 0
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.managerUids is list
        && request.resource.data.managerUids.size() == 0
        && request.resource.data.activeSessionId == null
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number;

      allow update: if isSignedIn()
        && arcadeImmutableUnchanged()
        && (
          // 1. Owner or authorized manager updating protected settings
          (
            isArcadeManager(resource.data)
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 3
            && request.resource.data.name.size() <= 40
            && request.resource.data.availableGames is list
            && request.resource.data.availableGames.size() >= 1
            && request.resource.data.visibility in ['invite-only', 'private']
            && request.resource.data.defaultMemoryCardCount is int
            && request.resource.data.defaultMemoryCardCount >= 10
            && request.resource.data.defaultMemoryCardCount <= 100
            && request.resource.data.defaultMemoryCardCount % 2 == 0
            && (isArcadeOwner(resource.data) || request.resource.data.managerUids == resource.data.managerUids)
          )
          ||
          // 2. User joining an invite-only active room (only adding own UID to memberUids)
          (
            resource.data.status == 'active'
            && resource.data.visibility == 'invite-only'
            && !(request.auth.uid in resource.data.memberUids)
            && (request.auth.uid in request.resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
          )
          ||
          // 3. Member leaving the room voluntarily (removing only own UID)
          (
            isArcadeMember(resource.data)
            && request.auth.uid != resource.data.ownerUid
            && !(request.auth.uid in request.resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'managerUids', 'updatedAt'])
          )
          ||
          // 4. Member starting or ending the single active game session (prevents duplicate active sessions)
          (
            isArcadeMember(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'activeSessionId',
              'activeSessionRoomCode',
              'activeSessionGameType',
              'updatedAt'
            ])
            && (
              (resource.data.activeSessionId == null && request.resource.data.activeSessionId is string)
              || (resource.data.activeSessionId != null && request.resource.data.activeSessionId == null)
            )
          )
        );

      // Strictly owner-only deletion
      allow delete: if isArcadeOwner(resource.data);

      function parentArcadeRoom() {
        return get(/databases/$(database)/documents/arcadeRooms/$(arcadeRoomId));
      }

      // Persistent Arcade Room Members subcollection
      match /members/{memberUid} {
        allow read: if isSignedIn()
          && (request.auth.uid in parentArcadeRoom().data.memberUids);

        allow create: if isSignedIn()
          && request.auth.uid == memberUid
          && request.resource.data.uid == request.auth.uid
          && (
            (request.resource.data.role == 'owner' && parentArcadeRoom().data.ownerUid == request.auth.uid)
            || request.resource.data.role == 'member'
          );

        allow update: if isSignedIn()
          && (
            (
              isRegisteredUser()
              && parentArcadeRoom().data.ownerUid == request.auth.uid
              && memberUid != parentArcadeRoom().data.ownerUid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role in ['manager', 'member']
            )
            || (
              request.auth.uid == memberUid
              && request.resource.data.uid == resource.data.uid
              && request.resource.data.role == resource.data.role
            )
          );

        allow delete: if isSignedIn()
          && (
            (isRegisteredUser() && parentArcadeRoom().data.ownerUid == request.auth.uid)
            || (
              isRegisteredUser()
              && (request.auth.uid in parentArcadeRoom().data.managerUids)
              && memberUid != parentArcadeRoom().data.ownerUid
              && !(memberUid in parentArcadeRoom().data.managerUids)
            )
            || (request.auth.uid == memberUid && memberUid != parentArcadeRoom().data.ownerUid)
          );
      }

      // Level 2: Game Sessions subcollection belonging to a valid Persistent Arcade Room
      match /sessions/{sessionId} {
        allow read: if isSignedIn()
          && (request.auth.uid in parentArcadeRoom().data.memberUids);

        allow create: if isSignedIn()
          && (request.auth.uid in parentArcadeRoom().data.memberUids)
          && request.resource.data.sessionId == sessionId
          && request.resource.data.arcadeRoomId == arcadeRoomId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.gameType in ['memory-match', 'tic-tac-toe']
          && request.resource.data.status == 'waiting'
          && request.resource.data.createdAt is number;

        allow update: if isSignedIn()
          && (request.auth.uid in parentArcadeRoom().data.memberUids)
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.arcadeRoomId == resource.data.arcadeRoomId
          && request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.gameType == resource.data.gameType
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isRegisteredUser()
          && parentArcadeRoom().data.ownerUid == request.auth.uid;
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
